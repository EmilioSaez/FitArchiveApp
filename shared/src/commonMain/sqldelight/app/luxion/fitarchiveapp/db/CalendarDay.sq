-- Look de un día. date en ISO-8601 (yyyy-MM-dd).
CREATE TABLE CalendarDay (
    date TEXT NOT NULL PRIMARY KEY,
    outfit_id INTEGER REFERENCES Outfit(id) ON DELETE SET NULL,
    note TEXT
);

CREATE INDEX calendar_day_outfit ON CalendarDay(outfit_id);

selectByDate:
SELECT * FROM CalendarDay WHERE date = ?;

-- Rango inclusivo de fechas ISO (el orden léxico coincide con el cronológico).
selectBetween:
SELECT * FROM CalendarDay WHERE date BETWEEN ? AND ? ORDER BY date;

upsert:
INSERT OR REPLACE INTO CalendarDay (date, outfit_id, note) VALUES (?, ?, ?);

deleteByDate:
DELETE FROM CalendarDay WHERE date = ?;

selectAll:
SELECT * FROM CalendarDay ORDER BY date;

deleteAll:
DELETE FROM CalendarDay;
