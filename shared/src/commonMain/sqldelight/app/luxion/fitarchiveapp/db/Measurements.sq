-- Una sola fila (id = 1): medidas de la usuaria en cm.
CREATE TABLE Measurements (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    height_cm REAL,
    bust_cm REAL,
    waist_cm REAL,
    hip_cm REAL,
    shoulders_cm REAL,
    arm_cm REAL,
    leg_cm REAL,
    foot_cm REAL,
    updated_at INTEGER NOT NULL
);

-- Columnas explícitas: ver el comentario de Garment.sq.
select:
SELECT id, height_cm, bust_cm, waist_cm, hip_cm, shoulders_cm, arm_cm, leg_cm, foot_cm, updated_at
FROM Measurements WHERE id = 1;

upsert:
INSERT OR REPLACE INTO Measurements (id, height_cm, bust_cm, waist_cm, hip_cm, shoulders_cm, arm_cm, leg_cm, foot_cm, updated_at)
VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM Measurements;
