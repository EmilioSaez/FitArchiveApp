-- Una sola fila (id = 1): aspecto del avatar 2D.
CREATE TABLE Avatar (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    skin_rgb INTEGER NOT NULL,
    hair_rgb INTEGER NOT NULL,
    hair_style TEXT NOT NULL,
    face_photo_path TEXT,
    use_photo INTEGER NOT NULL DEFAULT 0 CHECK (use_photo IN (0, 1))
);

select:
SELECT * FROM Avatar WHERE id = 1;

upsert:
INSERT OR REPLACE INTO Avatar (id, skin_rgb, hair_rgb, hair_style, face_photo_path, use_photo)
VALUES (1, ?, ?, ?, ?, ?);

delete:
DELETE FROM Avatar;
