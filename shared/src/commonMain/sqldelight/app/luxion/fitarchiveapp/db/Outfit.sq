CREATE TABLE Outfit (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    occasion TEXT,
    favorite INTEGER NOT NULL DEFAULT 0 CHECK (favorite IN (0, 1)),
    created_at INTEGER NOT NULL
);

-- Prendas de un outfit con su posición en el lienzo del avatar.
CREATE TABLE OutfitGarment (
    outfit_id INTEGER NOT NULL REFERENCES Outfit(id) ON DELETE CASCADE,
    garment_id INTEGER NOT NULL REFERENCES Garment(id) ON DELETE CASCADE,
    x REAL NOT NULL DEFAULT 0,
    y REAL NOT NULL DEFAULT 0,
    scale REAL NOT NULL DEFAULT 1,
    z_index INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (outfit_id, garment_id)
);

CREATE INDEX outfit_garment_garment ON OutfitGarment(garment_id);

selectAll:
SELECT * FROM Outfit ORDER BY created_at DESC, id DESC;

selectById:
SELECT * FROM Outfit WHERE id = ?;

selectFavorites:
SELECT * FROM Outfit WHERE favorite = 1 ORDER BY created_at DESC, id DESC;

insert:
INSERT INTO Outfit (name, occasion, favorite, created_at) VALUES (?, ?, ?, ?);

update:
UPDATE Outfit SET name = ?, occasion = ?, favorite = ? WHERE id = ?;

setFavorite:
UPDATE Outfit SET favorite = ? WHERE id = ?;

deleteById:
DELETE FROM Outfit WHERE id = ?;

lastInsertId:
SELECT last_insert_rowid();

selectGarments:
SELECT * FROM OutfitGarment WHERE outfit_id = ? ORDER BY z_index, garment_id;

insertGarment:
INSERT OR REPLACE INTO OutfitGarment (outfit_id, garment_id, x, y, scale, z_index) VALUES (?, ?, ?, ?, ?, ?);

deleteGarments:
DELETE FROM OutfitGarment WHERE outfit_id = ?;

-- Copia de seguridad: inserta conservando el id.
insertWithId:
INSERT INTO Outfit (id, name, occasion, favorite, created_at) VALUES (?, ?, ?, ?, ?);

deleteAll:
DELETE FROM Outfit;

selectAllGarments:
SELECT * FROM OutfitGarment ORDER BY outfit_id, garment_id;

deleteAllGarments:
DELETE FROM OutfitGarment;
